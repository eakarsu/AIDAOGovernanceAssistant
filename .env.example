NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
DATABASE_URL=postgresql://dao_app:replace-me@localhost:5432/aidao_governance
JWT_SECRET=replace-with-at-least-32-random-characters
